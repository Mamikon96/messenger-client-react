# Скопируйте в .env.development.local (файл в .gitignore) и поправьте под себя.

# Куда dev-сервер проксирует /api. По умолчанию — реальный бэкенд на 3333.
# Для mock-BFF: http://localhost:3334
BACKEND_URL=http://localhost:3333

# Адрес WebSocket в dev: напрямую на бэкенд, мимо dev-сервера (путь /ws занят HMR).
# В проде не задаётся: клиент берёт ws(s)://<host>/ws.
REACT_APP_WS_URL=ws://localhost:3333/ws
