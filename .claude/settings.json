{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-brief.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/context-guard.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-memory-check.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/context-guard.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_navigate_back",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_type",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_press_key",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_select_option",
      "mcp__plugin_playwright_playwright__browser_handle_dialog",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_emulate_media",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_close"
    ],
    "ask": [
      "Edit(docs/user-cases.md)",
      "Write(docs/user-cases.md)",
      "Edit(.ai/user-cases.sha256)",
      "Write(.ai/user-cases.sha256)",
      "Edit(scripts/approve-usecases.sh)",
      "Write(scripts/approve-usecases.sh)",
      "Edit(scripts/check-state.*)",
      "Write(scripts/check-state.*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ],
    "deny": [
      "Bash(scripts/approve-usecases.sh*)",
      "Bash(./scripts/approve-usecases.sh*)",
      "Bash(./approve-usecases.sh*)",
      "Bash(/*approve-usecases.sh*)",
      "Bash(bash scripts/approve-usecases.sh*)",
      "Bash(bash ./scripts/approve-usecases.sh*)",
      "Bash(bash approve-usecases.sh*)",
      "Bash(bash /*approve-usecases.sh*)",
      "Bash(sh scripts/approve-usecases.sh*)",
      "Bash(sh ./scripts/approve-usecases.sh*)",
      "Bash(sh approve-usecases.sh*)",
      "Bash(sh /*approve-usecases.sh*)",
      "Bash(source *approve-usecases.sh*)",
      "Bash(. *approve-usecases.sh*)",
      "Bash(bash -c *approve-usecases*)",
      "Bash(sh -c *approve-usecases*)",
      "Agent(angular-engineer)",
      "Agent(angular-reviewer)",
      "Agent(nestjs-engineer)",
      "Agent(nestjs-reviewer)",
      "Agent(nextjs-engineer)",
      "Agent(nextjs-reviewer)",
      "Agent(node-backend-engineer)",
      "Agent(node-backend-reviewer)",
      "Agent(sql-engineer)",
      "Agent(sql-reviewer)"
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": false,
    "code-review@anthropic-plugin-directory": false
  }
}
